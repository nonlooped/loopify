{
  "name": "loopify-desktop",
  "version": "0.5.1",
  "description": "Personal desktop music app for resolving, queueing, and playing online sources.",
  "author": "Loopify",
  "type": "module",
  "main": "out/main/app.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "pnpm run build && electron-builder --win nsis",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:win:dir": "pnpm run build && electron-builder --win dir",
    "dist:linux:dir": "pnpm run build && electron-builder --linux dir",
    "smoke:win": "pnpm run build && electron-builder --win dir --publish never -c.win.signAndEditExecutable=false",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@vitejs/plugin-react": "^6.0.1",
    "@xhayper/discord-rpc": "^1.3.4",
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.11.0",
    "ms": "^2.1.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "spotify-url-info": "^3.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^6.0.0-beta.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "com.loopify.desktop",
    "productName": "Loopify",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/binaries/",
        "to": "binaries",
        "filter": [
          "**/*",
          "!*.exe"
        ]
      }
    ],
    "win": {
      "icon": "src/renderer/public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Loopify-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "src/renderer/public/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "src/renderer/public/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Loopify-${version}-linux.${ext}",
      "category": "AudioVideo;Audio;Player"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "unloopedmido",
      "repo": "loopify",
      "releaseType": "release"
    }
  }
}

{
  "name": "loopify-desktop",
  "version": "0.12.2",
  "description": "Personal desktop music app for resolving, queueing, and playing online sources.",
  "author": "Loopify",
  "license": "MIT",
  "type": "module",
  "main": "out/main/app.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "predev": "pnpm run prepare:binaries",
    "dev": "electron-rebuild -f -w better-sqlite3 && electron-vite dev",
    "prebuild": "pnpm run prepare:binaries",
    "build": "electron-rebuild -f -w better-sqlite3 && electron-vite build",
    "prepreview": "pnpm run prepare:binaries",
    "dist:win": "pnpm run build && electron-builder --win nsis",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:win:dir": "pnpm run build && electron-builder --win dir",
    "dist:linux:dir": "pnpm run build && electron-builder --linux dir",
    "smoke:win": "pnpm run build && electron-builder --win dir --publish never -c.win.signAndEditExecutable=false",
    "preview": "electron-rebuild -f -w better-sqlite3 && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-drizzle-kit.cjs migrate",
    "db:verify": "node scripts/verify-drizzle-migrations.cjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare:binaries": "node scripts/bundle-binaries.js",
    "verify:mpv": "node scripts/verify-mpv.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@tanstack/react-virtual": "^3.13.24",
    "@xhayper/discord-rpc": "^1.3.4",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "execa": "^9.6.1",
    "focus-trap-react": "^12.0.1",
    "lru-cache": "^11.3.6",
    "lucide-react": "^1.14.0",
    "p-limit": "^7.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "spotify-url-info": "^3.3.0",
    "tailwind-merge": "^3.5.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@biomejs/biome": "^2.4.14",
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "1.0.0-rc.2",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "6.0.0-beta.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "com.loopify.desktop",
    "productName": "Loopify",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/db/migrations/",
        "to": "db/migrations",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/binaries/",
        "to": "binaries",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "src/renderer/public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Loopify-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "src/renderer/public/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "src/renderer/public/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Loopify-${version}-linux.${ext}",
      "category": "AudioVideo;Audio;Player"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "nonlooped",
      "repo": "loopify",
      "releaseType": "release"
    }
  }
}

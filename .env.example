# Copy to `.env` in the repo root (same directory as docker-compose.yml).
# Docker Compose loads this file for variable substitution in docker-compose.yml.

# --- Lavalink (must match infra/application.yml substitution) ---
LAVALINK_SERVER_PASSWORD=change-me-to-a-long-random-string
SERVER_ADDRESS=0.0.0.0

# Bot Lavalink client (Compose sets these; set manually for local runs without Compose)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333

# Host port published for Lavalink HTTP/WebSocket (container stays on 2333).
LAVA_PUBLISH_PORT=2333

# --- Discord bot (required) ---
DISCORD_TOKEN=
CLIENT_ID=

# Development-style guild command sync. With NODE_ENV=production (set in compose for `bot`)
# this is not required; set it if you override NODE_ENV to non-production in the bot service.
# Required for `pnpm run docker:dev` (docker-compose.dev.yml sets NODE_ENV=development on the bot).
GUILD_ID=

# --- Web ---
WEB_PUBLISH_PORT=8080
# Host port for the Vite dev server when using docker-compose.dev.yml (default 5173).
WEB_DEV_PUBLISH_PORT=5173

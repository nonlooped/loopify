# Copy to `.env` in the repo root (next to docker-compose.yml).
# Docker Compose loads this file for variable substitution and container env.

# --- Lavalink ---
LAVALINK_SERVER_PASSWORD=change-me-to-a-long-random-string
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333

# --- Service URLs / ports ---
SERVER_PORT=4000
MUSIC_SERVER_URL=http://127.0.0.1:4000
PUBLIC_BASE_URL=http://localhost:5173
VITE_DEV_PROXY_TARGET=http://127.0.0.1:4000

# --- Bot <-> server trust token ---
BOT_LINK_TOKEN=change-me-bot-link-token

# --- Discord bot ---
DISCORD_TOKEN=
CLIENT_ID=
# Optional: when set, slash commands sync to this guild (instant). Leave blank for global.
GUILD_ID=

# --- OAuth for web controller (handled by Express server) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:4000/auth/discord/callback
SESSION_SECRET=change-me-session-secret

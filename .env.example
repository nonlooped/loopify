# Copy to `.env` in the repo root (next to docker-compose.yml).
# Docker Compose loads this file for variable substitution and container env.

# --- Lavalink ---
LAVALINK_SERVER_PASSWORD=change-me-to-a-long-random-string

# --- Shared internal Bearer token (server <-> bot <-> web) ---
INTERNAL_API_TOKEN=change-me-internal-api-token

# --- Discord bot ---
DISCORD_TOKEN=
CLIENT_ID=
# Optional: when set, slash commands sync to this guild (instant). Leave blank for global.
GUILD_ID=

# --- Web controller (OAuth + UI) ---
PUBLIC_BASE_URL=http://localhost:8080
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8080/auth/discord/callback
WEB_SESSION_SECRET=change-me-web-session-secret

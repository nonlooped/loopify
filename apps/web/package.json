{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --config vite.config.ts",
    "dev:api": "tsx watch server/index.ts",
    "build": "pnpm --filter @loopify/protocol build && vite build --config vite.config.ts && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@loopify/protocol": "workspace:*",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.11.3",
    "jose": "^6.1.3",
    "lucide-react": "^0.542.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "shadcn": "^4.3.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
